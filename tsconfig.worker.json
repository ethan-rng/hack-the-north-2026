{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": [
    "cloudflare/**/*.ts",
    "src/core/**/*.ts",
    "services/jev-worker/src/jev-response.ts"
  ]
}
