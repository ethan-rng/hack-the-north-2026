# Copy to .env.local and fill in real values.

# Anthropic (research LLM, planner LLM, report LLM)
ANTHROPIC_API_KEY=sk-ant-...

# TypeSafe Jev runs on Cloudflare Workers AI via the worker/ proxy — no
# separate API key. Set this to the URL wrangler prints after `npm run worker:deploy`
# e.g. https://htn26-jev-proxy.<subdomain>.workers.dev
JEV_WORKER_URL=

# Force the mock Jev even when JEV_WORKER_URL is set. Handy for dev without
# burning CF Workers AI quota.
USE_MOCK_JEV=true
